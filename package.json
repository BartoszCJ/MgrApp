{
  "name": "magisterkaapp",
  "version": "0.1.0",
  "private": true,
  "description": "Forensics blockchain tracer - monorepo (backend + frontend)",
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,green --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "uv --project backend run forensics serve",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && uv --project backend sync --extra dev && npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "uv --project backend run pytest backend/tests",
    "lint:backend": "uv --project backend run ruff check backend/src"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
